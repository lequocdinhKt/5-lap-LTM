# Server A local example. Copy to server-a.properties and edit peer IP.
server.id=server-a
server.host=auto
rmi.registry.port=1099
rmi.service.port=1100
peer.server.host=
peer.rmi.port=1099
lock.coordinator.host=auto
lock.coordinator.port=1099
db.url=jdbc:mysql://127.0.0.1:3306/lab5_warehouse?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
db.username=root
db.password=
lock.lease.seconds=30
